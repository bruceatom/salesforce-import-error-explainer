<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Required_For_Customer</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Contact_Type__c, "Customer"), ISBLANK(Phone))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone is required for Customer contacts</errorMessage>
</ValidationRule>
